# Directory of documents to index. Defaults to ../docs (the public law texts).
# Point this at ../private-docs to index your own files instead.
DOCS_DIR=../docs

# Which LLM generates the final answer: anthropic | ollama | none
# "none" (the default) runs retrieval only, with no answer generation and no API key needed.
LLM_PROVIDER=none

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only needed when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434
